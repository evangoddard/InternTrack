# Copy this file to .env.local and fill in the values.
#
# .env.local is gitignored; this template is not. Nothing with a real value
# belongs in here.

# ---------------------------------------------------------------------------
# Supabase (required)
#
# Project Settings -> API in the Supabase dashboard. Both of these are the
# public/client-safe keys -- they are meant to be exposed to the browser and
# are protected by Row Level Security, not by secrecy. Never put the
# "service_role" key here or anywhere in this app; it isn't needed.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Site origin (REQUIRED BEFORE LAUNCH)
#
# The absolute origin used for canonical URLs, Open Graph tags, and
# sitemap.xml. Set this to the real domain once it is registered, e.g.
#
#   NEXT_PUBLIC_SITE_URL=https://interntrack.com
#
# Leave it unset and everything falls back to http://localhost:3000 (or, on
# Vercel, the project's production URL). Shipping with the localhost fallback
# means search engines and social scrapers see URLs nobody can reach.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# Optional
#
# GA4 measurement ID. Leave blank and no analytics script loads and no
# analytics cookies are set -- the site works identically without it.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Support address. Leave blank and the footer's Contact link is omitted
# entirely rather than pointing at an address that does not exist.
NEXT_PUBLIC_SUPPORT_EMAIL=
